{
  "uid": "claude-code-usage",
  "title": "Claude Code Usage",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total cost ($)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_cost_usage_USD_total[$__range]))", "legendFormat": "cost" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } }
    },
    {
      "id": 2,
      "title": "Sessions",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_session_count_total[$__range]))", "legendFormat": "sessions" }
      ]
    },
    {
      "id": 3,
      "title": "Commits",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_commit_count_total[$__range]))", "legendFormat": "commits" }
      ]
    },
    {
      "id": 4,
      "title": "Pull requests",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_pull_request_count_total[$__range]))", "legendFormat": "PRs" }
      ]
    },
    {
      "id": 5,
      "title": "Token usage by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 6,
      "title": "Cost over time by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 7,
      "title": "Lines of code (added/removed)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_lines_of_code_count_total[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Code edit decisions (accept/reject)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        {
          "expr": "sum by (decision) (increase(claude_code_code_edit_tool_decision_total[$__range]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Active time by type (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_active_time_seconds_total[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 11,
      "title": "Code edits by source",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        {
          "expr": "sum by (source) (increase(claude_code_code_edit_tool_decision_total[$__range]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Code edits by language",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        {
          "expr": "sum by (language) (increase(claude_code_code_edit_tool_decision_total[$__range]))",
          "legendFormat": "{{language}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "MCP server connections by status",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({service_name=\"claude-code\"} | event_name=`mcp_server_connection` [$__range]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "API errors & retries",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 37 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=~`api_error|api_retries_exhausted` [$__range]))"
        }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "id": 15,
      "title": "Hook & plugin activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 37 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "targets": [
        {
          "expr": "sum by (event_name) (count_over_time({service_name=\"claude-code\"} | event_name=~`hook_execution_start|hook_execution_complete|hook_registered|plugin_loaded` [$__interval]))",
          "legendFormat": "{{event_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 10,
      "title": "Recent Claude Code events",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 45 },
      "datasource": { "type": "loki", "uid": "claude-loki" },
      "targets": [
        { "expr": "{service_name=\"claude-code\"}" }
      ]
    },
    {
      "id": 16,
      "title": "Recent Claude Code traces",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 55 },
      "datasource": { "type": "tempo", "uid": "claude-tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name=\"claude-code\"}",
          "tableType": "traces",
          "limit": 20
        }
      ]
    }
  ]
}
