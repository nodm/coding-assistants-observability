{
  "uid": "ai-assistant-overview",
  "title": "AI Assistant Overview",
  "description": "Side-by-side comparison of Claude Code, GitHub Copilot CLI, and GitHub Copilot Chat (VS Code)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Claude Code cost ($) — only tool reporting USD",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_cost_usage_USD_total[$__range]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } }
    },
    {
      "id": 10,
      "title": "Input tokens by tool",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"input\"}[$__range]))", "legendFormat": "Claude Code" },
        { "expr": "sum(increase(gen_ai_client_inference_usage_input_tokens_total[$__range]))", "legendFormat": "Copilot CLI" },
        { "expr": "sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\"}[$__range]))", "legendFormat": "Copilot Chat" }
      ]
    },
    {
      "id": 11,
      "title": "Output tokens by tool",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"output\"}[$__range]))", "legendFormat": "Claude Code" },
        {
          "expr": "(sum(increase(gen_ai_client_inference_usage_output_tokens_total[$__range])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_reasoning_output_tokens_total[$__range])) or vector(0))",
          "legendFormat": "Copilot CLI"
        },
        { "expr": "sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\"}[$__range]))", "legendFormat": "Copilot Chat" }
      ]
    },
    {
      "id": 12,
      "title": "Cache tokens by tool",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_token_usage_tokens_total{type=~\"cacheRead|cacheCreation\"}[$__range]))", "legendFormat": "Claude Code" },
        {
          "expr": "(sum(increase(gen_ai_client_inference_usage_cache_read_input_tokens_total[$__range])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_cache_write_input_tokens_total[$__range])) or vector(0))",
          "legendFormat": "Copilot CLI"
        },
        {
          "expr": "sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=~\"cache_read|cache_write\"}[$__range])) or vector(0)",
          "legendFormat": "Copilot Chat (none seen yet)"
        }
      ]
    },
    {
      "id": 13,
      "title": "Total tokens by tool (input + output + cache)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_token_usage_tokens_total[$__range]))", "legendFormat": "Claude Code" },
        {
          "expr": "(sum(increase(gen_ai_client_inference_usage_input_tokens_total[$__range])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_output_tokens_total[$__range])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_cache_read_input_tokens_total[$__range])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_cache_write_input_tokens_total[$__range])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_reasoning_output_tokens_total[$__range])) or vector(0))",
          "legendFormat": "Copilot CLI"
        },
        { "expr": "sum(increase(gen_ai_client_token_usage_sum[$__range]))", "legendFormat": "Copilot Chat" }
      ]
    },
    {
      "id": 6,
      "title": "Sessions / invocations by tool",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_session_count_total[$__range]))", "legendFormat": "Claude Code" },
        { "expr": "sum(increase(gen_ai_invoke_agent_duration_seconds_count[$__range]))", "legendFormat": "Copilot CLI" },
        { "expr": "sum(increase(copilot_chat_session_count_total[$__range]))", "legendFormat": "Copilot Chat" }
      ]
    },
    {
      "id": 7,
      "title": "Total token usage over time by tool",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_token_usage_tokens_total[$__rate_interval]))", "legendFormat": "Claude Code" },
        {
          "expr": "(sum(increase(gen_ai_client_inference_usage_input_tokens_total[$__rate_interval])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_output_tokens_total[$__rate_interval])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_cache_read_input_tokens_total[$__rate_interval])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_cache_write_input_tokens_total[$__rate_interval])) or vector(0)) + (sum(increase(gen_ai_client_inference_usage_reasoning_output_tokens_total[$__rate_interval])) or vector(0))",
          "legendFormat": "Copilot CLI"
        },
        { "expr": "sum(increase(gen_ai_client_token_usage_sum[$__rate_interval]))", "legendFormat": "Copilot Chat" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } }
    }
  ]
}
